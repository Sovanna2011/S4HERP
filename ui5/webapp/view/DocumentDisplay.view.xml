<mvc:View
    controllerName="s4herp.ui.controller.DocumentDisplay"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">
    <f:DynamicPage id="documentPage" headerExpanded="true" showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title id="documentTitle" text="{/documentNumberFormatted}"/></f:heading>
                <f:expandedContent>
                    <ObjectStatus text="{/status}"
                                  state="{path: '/status', formatter: '.formatter.documentStatusState'}"/>
                </f:expandedContent>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" press=".onNavBack" tooltip="{i18n>back}"/>
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <form:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="3" columnsM="2">
                    <Label text="{i18n>companyCode}"/><Text text="{/companyCode}"/>
                    <Label text="{i18n>fiscalYear}"/><Text text="{/fiscalYear}"/>
                    <Label text="{i18n>period}"/><Text text="{/fiscalPeriod}"/>
                    <Label text="{i18n>documentType}"/><Text text="{/documentType}"/>
                    <Label text="{i18n>postingDate}"/><Text text="{/postingDate}"/>
                    <Label text="{i18n>currency}"/><Text text="{/currency}"/>
                    <Label text="{i18n>reference}"/><Text text="{/reference}"/>
                    <Label text="{i18n>headerText}"/><Text text="{/headerText}"/>
                </form:SimpleForm>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
          <VBox>
            <!-- Only present once a document has been through approval, so it does
                 not take up room on the ordinary posted document. -->
            <Panel id="workflowPanel"
                   headerText="{i18n>approvalHistory}"
                   expandable="true"
                   expanded="true"
                   visible="{= !!${workflow>/status} }">
                <content>
                    <ObjectStatus id="workflowStatus"
                                  class="sapUiSmallMarginBegin"
                                  title="{i18n>approvalStatus}"
                                  text="{workflow>/status}"
                                  state="{path: 'workflow>/status', formatter: '.formatter.workflowStatusState'}"/>
                    <Text class="sapUiSmallMargin"
                          text="{i18n>submittedBy} {workflow>/submittedBy}"/>
                    <Table id="workflowSteps" items="{workflow>/steps}">
                        <columns>
                            <Column width="4rem"><Text text="{i18n>step}"/></Column>
                            <Column><Text text="{i18n>approverRole}"/></Column>
                            <Column><Text text="{i18n>decision}"/></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>decidedBy}"/></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>comment}"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{workflow>sequence}"/>
                                    <Text text="{workflow>approverRoleCode}"/>
                                    <ObjectStatus text="{workflow>decision}"
                                                  state="{path: 'workflow>decision', formatter: '.formatter.stepDecisionState'}"/>
                                    <Text text="{workflow>decidedBy}"/>
                                    <Text text="{workflow>comment}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Panel>

            <Table id="documentLines" items="{/lines}">
                <columns>
                    <Column width="4rem"><Text text="{i18n>lineNumber}"/></Column>
                    <Column width="6rem"><Text text="{i18n>postingKey}"/></Column>
                    <Column><Text text="{i18n>account}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>costCenter}"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>profitCenter}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>documentAmount}"/></Column>
                    <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>localAmount}"/></Column>
                    <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>lineText}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{lineNumber}"/>
                            <Text text="{postingKey}"/>
                            <ObjectIdentifier title="{glAccount}" text="{businessPartner}"/>
                            <Text text="{costCenter}"/>
                            <Text text="{profitCenter}"/>
                            <ObjectNumber number="{path: 'documentAmount', formatter: '.formatter.amount'}"
                                          state="{path: 'debitCredit', formatter: '.formatter.debitCreditState'}"/>
                            <Text text="{path: 'localAmount', formatter: '.formatter.signedAmount'}"/>
                            <Text text="{lineText}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
          </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <!-- Buttons are hidden by status for usability only. Every one of
                     these actions is refused server-side on its own authority; §22.1
                     is explicit that hiding a control is not authorisation, and the
                     acceptance suite posts as an unauthorised user to prove it. -->
                <Button id="discardButton"
                        text="{i18n>discard}"
                        type="Transparent"
                        visible="{= ${/status} === 'Parked' || ${/status} === 'Rejected' }"
                        press=".onDiscard"/>
                <Button id="withdrawButton"
                        text="{i18n>withdraw}"
                        visible="{= ${/status} === 'PendingApproval' }"
                        press=".onWithdraw"/>
                <Button id="rejectButton"
                        text="{i18n>reject}"
                        type="Reject"
                        visible="{= ${/status} === 'PendingApproval' }"
                        press=".onReject"/>
                <Button id="approveButton"
                        text="{i18n>approve}"
                        type="Accept"
                        visible="{= ${/status} === 'PendingApproval' }"
                        press=".onApprove"/>
                <Button id="submitButton"
                        text="{i18n>submitForApproval}"
                        type="Emphasized"
                        visible="{= ${/status} === 'Parked' }"
                        press=".onSubmit"/>
                <Button id="reverseButton"
                        text="{i18n>reverse}"
                        type="Reject"
                        visible="{= ${/status} === 'Posted' }"
                        press=".onReverse"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
