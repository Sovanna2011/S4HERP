{
  "name": "s4herp-ui",
  "version": "1.0.0",
  "private": true,
  "description": "S4HERP OpenUI5 front end: Launchpad-style shell and finance applications.",
  "scripts": {
    "start": "ui5 serve --port 8081",
    "build": "ui5 build --all --clean-dest --dest ../src/Host/S4HERP.Host/wwwroot",
    "lint": "ui5 lint",
    "prebuild": "node -e \"require('fs').copyFileSync('webapp/i18n/i18n.properties','webapp/i18n/i18n_en.properties')\""
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.60"
  }
}
