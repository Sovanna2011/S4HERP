# Copy to .env and change the password before starting the stack.
# SQL Server requires >= 8 chars with uppercase, lowercase, digits and symbols.
MSSQL_SA_PASSWORD=Ch4nge_this_P@ssw0rd

# Developer | Express | Standard | Enterprise | EnterpriseCore
MSSQL_PID=Developer

MSSQL_DATABASE=S4HERP

# Host ports
MSSQL_PORT=1433
API_PORT=8080

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Only needed behind a TLS-inspecting corporate proxy. Point it at the proxy's
# root certificate and the image build will trust it; without it, `dotnet
# restore` and `npm ci` fail inside the build with UntrustedRoot (NuGet reports
# NU1301, which misleadingly reads as "the feed is unreachable").
# EXTRA_CA_BUNDLE=/etc/ssl/certs/corporate-root.crt
